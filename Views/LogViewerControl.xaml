<UserControl x:Class="RAIDAR_FRONT.Views.LogViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InfoLevelBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="WarningLevelBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ErrorLevelBrush" Color="#EF4444" />
    </UserControl.Resources>

    <Border Background="#0A0E1A" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1.5" Margin="6" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        
            <!-- 로그 뷰어 상단 헤더-->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 REALTIME SYSTEM &amp; ERROR EVENT LOGS" Foreground="#00F0FF" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="{Binding Logs.Count, StringFormat=' ({0} entries)'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CLEAR LOGS" Command="{Binding ClearLogsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,4" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            
            <!-- 로그 바인딩 리스트 -->
            <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Background="#060913">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#111827" BorderThickness="0,0,0,1" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 시각 -->
                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Foreground="#64748B" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

                                    <!-- 레벨 -->
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Padding="6,2" CornerRadius="3" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Background" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                    </Border>

                                    <!-- 소스 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>

                                    <!-- 메시지 -->
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#E2E8F0" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
    
    
</UserControl>
